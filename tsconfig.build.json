{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/types.ts",
    "src/utils.ts",
    "src/global.d.ts",
    "src/components/**/*.tsx"
  ],
  "exclude": [
    "src/main.tsx"
  ]
}
