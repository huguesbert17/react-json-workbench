{
  "name": "react-json-workbench",
  "version": "0.1.5",
  "private": false,
  "description": "A lightweight, extensible JSON viewer and editor for React with tree inspection, CodeMirror editing, contextual actions, formatting, and theming.",
  "keywords": [
    "react",
    "json",
    "json-viewer",
    "json-editor",
    "json-tree",
    "codemirror",
    "typescript",
    "developer-tools"
  ],
  "homepage": "https://huguesbert17.github.io/react-json-workbench/",
  "bugs": {
    "url": "https://github.com/huguesbert17/react-json-workbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huguesbert17/react-json-workbench.git"
  },
  "license": "MIT",
  "author": "Hugues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --mode demo",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:lib",
    "build:lib": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --mode demo",
    "prepare": "npm run build:lib",
    "prepublishOnly": "npm run typecheck && npm run build:lib",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
